# config.yaml.example
#
# Copy this file to config.yaml and customize for your environment.
# Environment variables can override any value using underscore notation:
#   server.port -> SERVER_PORT
#   ai.gemini_api_key -> AI_GEMINI_API_KEY

# ============================================================================
# Server Configuration
# ============================================================================
server:
  port: "8080"
  max_workers: 5

# ============================================================================
# GitHub App Configuration (required for server mode)
# ============================================================================
github:
  # GitHub App ID (required for server)
  app_id: 0
  # Webhook secret for validating GitHub webhooks
  webhook_secret: ""
  # Path to the GitHub App private key file
  private_key_path: "keys/code-warden-app.private-key.pem"
  # Personal access token (for CLI commands like preload)
  token: "ghp_YOUR_PERSONAL_ACCESS_TOKEN_HERE"

# ============================================================================
# AI Configuration
# ============================================================================
ai:
  # LLM provider for code generation: "ollama", "gemini", or "openai"
  llm_provider: "ollama"

  # Ollama settings (when using ollama provider)
  # Point to your LOCAL Ollama instance (not Docker)
  ollama_host: "http://localhost:11434"

  # Gemini settings (when using gemini provider)
  # Set via environment variable AI_GEMINI_API_KEY for security
  gemini_api_key: ""

  # OpenAI-compatible provider settings (when using openai provider).
  # Any OpenAI-compatible endpoint works: OpenAI, Azure, OpenRouter, vLLM, LM Studio.
  # openai_base_url: "https://api.openai.com/v1"
  # openai_api_key: ""   # Set via AI_OPENAI_API_KEY env var for security
  # openai_model: ""     # Defaults to ai.generator_model if unset

  # Model names
  # Generator Model (The "Main Driver")
  generator_model: "kimi-k2.5:cloud"

  # Thinking/Reasoning Mode - for models that support it (DeepSeek-R1, Qwen 3, Kimi-K2.5, etc.)
  # Enables transparent decision-making in code reviews.
  enable_thinking: false
  # Thinking effort level: "low", "medium", "high" (for supported models)
  thinking_effort: "medium"

  # Model Memory Management - keep models loaded for faster subsequent responses
  model_keep_alive: "10m"

  # HTTP Client Overrides
  # Timeout for waiting for the first byte of an LLM response (headers).
  http_response_header_timeout: "15m"

  # Overall HTTP request timeout (including body transfer).
  # Set to "0" or omit to disable.
  # http_request_timeout: "0"

  # Review output options
  # Include code suggestions in review comments (GitHub suggestion blocks).
  enable_code_suggestions: true

# ============================================================================
# Agent Configuration (Autonomous Issue Implementation)
# ============================================================================
# The agent system implements GitHub issues autonomously using AI.
#
#   "warden" (recommended) — phased plan→implement→review→publish loop using
#   the agent-based review engine (grep + read_file). Tools injected in-process.
agent:
  # Enable the agent system for /implement comments on GitHub issues
  enabled: true

  # "warden" activates the phased plan→implement→publish harness.
  mode: "warden"

  # Skip the MCP HTTP server — tools are registered directly in the goframe
  # agent registry.
  in_process_only: true

  # Base branch for pull requests opened by the agent (default: "main").
  base_branch: "main"

  # Maximum review→fix iterations in the implement loop before the agent
  # yields a draft PR for human review.
  max_iterations: 3

  # Maximum concurrent agent sessions.
  max_concurrent_sessions: 3

  # Maximum time for a single agent session.
  timeout: "1h"

  # Working directory for isolated agent workspaces.
  working_dir: "/tmp/code-warden-agents"

# ============================================================================
# Storage Configuration
# ============================================================================
storage:
  # Local path for cloned repositories
  repo_path: "./data/repos"

# ============================================================================
# Database Configuration
# ============================================================================
database:
  host: "localhost"
  port: 5432
  database: "codewarden"
  username: "warden"
  # Set via environment variable DATABASE_PASSWORD for security
  password: "secret"
  ssl_mode: "disable"
  conn_max_lifetime: "5m"
  conn_max_idle_time: "5m"

# ============================================================================
# Logging Configuration
# ============================================================================
logging:
  # Log level: "debug", "info", "warn", "error"
  level: "info"
  # Log format: "text" or "json"
  format: "text"
  # Output: "stdout", "stderr", or "file"
  output: "stdout"
