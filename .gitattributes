# Normalize line endings to LF for source files. Without this, Windows checkouts
# get CRLF (via core.autocrlf=true) and the goimports linter on Linux CI flags
# every file as "not properly formatted" because goimports is sensitive to line
# endings.
*.go    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ps1   text eol=lf
*.sh    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
Dockerfile text eol=lf