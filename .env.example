# .env.example — Code-Warden configuration
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Env vars override config.yaml values automatically (Viper AutomaticEnv).
# Mapping: section.key → SECTION_KEY  (e.g. ai.ollama_host → AI_OLLAMA_HOST)
#
# NOTE: GitHub App and LLM credentials are OPTIONAL in config files.
# They are configured automatically via the setup wizard and stored
# encrypted in the database. Only set them here for advanced/CLI-only use.

# ── Infrastructure (required) ────────────────────────────────────────────────

# PostgreSQL connection — matches docker-compose.demo.yml defaults
DATABASE_HOST=db
DATABASE_PASSWORD=secret

# Ollama endpoint — defaults to localhost for native (non-Docker) runs.
# When running via docker-compose.demo.yml, this is overridden to
# http://ollama:11434 by the compose environment section.
AI_OLLAMA_HOST=http://localhost:11434

# ── GitHub (optional — configure via setup wizard instead) ────────────────────

# Personal Access Token — for CLI demo (no GitHub App needed)
# Required scopes: repo (or repo:read for private repos)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub App credentials — full server mode only
# If left empty, the setup wizard will create the App automatically via
# GitHub's Manifest flow and store credentials in the database.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# ── AI / LLM (optional — configure via setup wizard instead) ─────────────────

# Provider: "ollama" (local), "gemini" (cloud), or "openai" (any OpenAI-compatible endpoint)
AI_LLM_PROVIDER=ollama

# Model (change to larger models for better review quality)
AI_GENERATOR_MODEL=kimi-k2.5

# Gemini API key — required only when AI_LLM_PROVIDER=gemini
# AI_GEMINI_API_KEY=

# OpenAI-compatible API key — required only when AI_LLM_PROVIDER=openai
# AI_OPENAI_API_KEY=
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
